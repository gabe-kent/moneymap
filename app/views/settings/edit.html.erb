<div class="w-full max-w-2xl mx-auto flex flex-col gap-6">
  <h1 class="text-4xl font-bold">Settings</h1>

  <div class="card bg-base-100 shadow-sm">
    <div class="card-body">
      <h2 class="card-title">Account</h2>
      <p class="text-sm text-base-content/70">Signed in as <span class="font-medium"><%= @user.email_address %></span></p>
    </div>
  </div>

  <div class="card bg-base-100 shadow-sm">
    <div class="card-body">
      <h2 class="card-title">Change password</h2>

      <% if @user.errors.any? %>
        <div class="alert alert-error">
          <ul>
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with url: settings_path, method: :patch do |form| %>
        <div class="mb-4">
          <%= label_tag :current_password, "Current password", class: "label" %>
          <%= password_field_tag :current_password, nil, required: true, autocomplete: "current-password", class: "input input-bordered w-full" %>
        </div>

        <div class="mb-4">
          <%= form.label :password, "New password", class: "label" %>
          <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: "input input-bordered w-full" %>
        </div>

        <div class="mb-6">
          <%= form.label :password_confirmation, "Confirm new password", class: "label" %>
          <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "input input-bordered w-full" %>
        </div>

        <%= form.submit "Update password", class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>

  <div class="card bg-base-100 shadow-sm">
    <div class="card-body">
      <div class="flex justify-between items-center">
        <h2 class="card-title">Active sessions</h2>
        <% if @sessions.size > 1 %>
          <%= button_to "Sign out of all other sessions", destroy_all_user_sessions_path, method: :delete, data: { turbo_confirm: "Sign out of all other sessions?" }, class: "btn btn-sm btn-ghost text-error" %>
        <% end %>
      </div>

      <div class="overflow-x-auto">
        <table class="table">
          <thead>
            <tr>
              <th>Device</th>
              <th>IP address</th>
              <th>Signed in</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% @sessions.each do |session| %>
              <tr>
                <td>
                  <%= session.user_agent.presence || "Unknown device" %>
                  <% if session == Current.session %>
                    <span class="badge badge-sm badge-primary ml-2">This session</span>
                  <% end %>
                </td>
                <td><%= session.ip_address.presence || "—" %></td>
                <td><%= time_ago_in_words(session.created_at) %> ago</td>
                <td class="text-right">
                  <%= button_to (session == Current.session ? "Sign out" : "Revoke"), user_session_path(session), method: :delete, data: { turbo_confirm: "Sign out of this session?" }, class: "btn btn-sm btn-ghost text-error" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
