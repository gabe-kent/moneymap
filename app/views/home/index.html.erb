<div class="card bg-base-100 shadow-sm w-full">
  <div class="card-body">
    <h1 class="card-title text-4xl">Welcome to Moneymap</h1>
    <% if authenticated? %>
      <p>Signed in as <%= Current.user.email_address %>.</p>
    <% else %>
      <p><%= link_to "Sign in", new_session_path, class: "link" %> to get started.</p>
    <% end %>
  </div>
</div>
