<% content_for :title, "Dashboard · Moneymap" %>

<%= render layout: "shared/page_header",
      locals: { title: "Dashboard",
                subtitle: "#{time_of_day_greeting}, #{Current.user.email_address.split("@").first.titleize}. Here's where things stand." } do %>
  <%= link_to new_transaction_path, class: primary_button_classes do %>
    <%= icon "circle-plus", class: "size-4" %>
    Add transaction
  <% end %>
<% end %>

<% if @summary.accounts.empty? %>
  <%= render "shared/empty_state",
        icon: "landmark",
        title: "No accounts yet",
        body: "Add a checking, savings or credit account and Moneymap will start tracking your balances, spending and net worth here.",
        action_label: "Add your first account",
        action_path: new_account_path %>
<% else %>

  <%# ---- KPI row ------------------------------------------------------- %>
  <div class="flex gap-5">
    <% @summary.kpis.each do |kpi| %>
      <div class="<%= panel_classes("flex-1 py-[22px] px-6") %>">
        <div class="<%= eyebrow_classes %>"><%= kpi.label %></div>
        <div class="mt-2 text-[30px] font-black text-green-black tracking-[-0.01em] leading-none"><%= kpi.value %></div>
        <div class="mt-2 flex items-center gap-1.5 text-[13px] font-semibold <%= tone_class(kpi.tone) %>">
          <%= trend_icon kpi.direction, class: "size-[13px]" %>
          <span><%= kpi.delta_text %></span>
        </div>
      </div>
    <% end %>
  </div>

  <%# ---- Cash flow + insights ------------------------------------------ %>
  <div class="flex gap-5 items-stretch">
    <div class="<%= panel_classes("flex-[1.4] p-6") %>">
      <div class="flex justify-between items-center">
        <div class="<%= section_heading_classes %>">Cash flow</div>
        <div class="flex gap-4 text-xs text-gray-500">
          <span class="flex items-center gap-1.5"><span class="size-2 rounded-full bg-invoca-green"></span>Income</span>
          <span class="flex items-center gap-1.5"><span class="size-2 rounded-full bg-gray-400"></span>Expenses</span>
        </div>
      </div>

      <div class="mt-6 flex justify-around items-end h-[200px]">
        <% @summary.cash_flow.each do |bar| %>
          <div class="flex flex-col items-center gap-2.5 flex-1">
            <div class="flex items-end gap-1.5 h-[170px]">
              <div class="w-[22px] bg-invoca-green rounded-t-md" style="height: <%= bar.income_height %>px"
                   title="Income: <%= money_amount(bar.income) %>"></div>
              <div class="w-[22px] bg-gray-300 rounded-t-md" style="height: <%= bar.expense_height %>px"
                   title="Expenses: <%= money_amount(bar.expense) %>"></div>
            </div>
            <span class="text-xs font-semibold text-gray-500"><%= bar.label %></span>
          </div>
        <% end %>
      </div>
    </div>

    <div class="<%= panel_classes("flex-1 p-6 flex flex-col gap-3.5") %>">
      <div class="<%= section_heading_classes %>">Insights</div>
      <% @summary.insights.each do |insight| %>
        <div class="flex gap-3 p-3 rounded-xl <%= insight.tone == :good ? "bg-mint" : "bg-sand" %>">
          <span class="size-8 rounded-xl bg-white flex items-center justify-center shrink-0">
            <%= icon insight.icon, class: class_names("size-4", insight.tone == :good ? "text-invoca-green" : insight.tone == :bad ? "text-problem-red" : "text-green-black") %>
          </span>
          <p class="text-[13px] leading-[1.45] text-gray-800"><%= insight.text %></p>
        </div>
      <% end %>
    </div>
  </div>

  <%# ---- Accounts ------------------------------------------------------- %>
  <div>
    <div class="flex justify-between items-center mb-3.5">
      <div class="<%= section_heading_classes %>">Accounts</div>
      <%= link_to "Manage →", accounts_path, class: "text-[13px] font-semibold text-invoca-green hover:text-green-600 hover:underline" %>
    </div>
    <div class="flex gap-4">
      <% @summary.accounts.each do |card| %>
        <div class="<%= panel_classes("flex-1 p-5") %>">
          <div class="flex items-center gap-2.5">
            <span class="size-[30px] rounded-lg bg-mint flex items-center justify-center shrink-0">
              <%= icon card.account.icon_name, class: "size-3.5 text-deep-green" %>
            </span>
            <span class="<%= eyebrow_classes %>"><%= card.account.kind.titleize %></span>
          </div>
          <div class="mt-3.5 text-[22px] font-black <%= account_balance_class(card.balance) %>"><%= money_amount(card.balance) %></div>
          <div class="mt-0.5 text-[13px] text-gray-500 truncate"><%= card.account.name %></div>
        </div>
      <% end %>
    </div>
  </div>

  <%# ---- Category donut + recent activity ------------------------------- %>
  <div class="flex gap-5 items-stretch">
    <div class="<%= panel_classes("flex-1 p-6") %>">
      <div class="<%= section_heading_classes %> mb-[18px]">Spending by category · <%= @summary.analysis_month.strftime("%B") %></div>

      <% if @summary.donut_slices.empty? %>
        <p class="text-sm text-gray-500">No categorised spending in <%= @summary.analysis_month.strftime("%B") %>.</p>
      <% else %>
        <div class="flex gap-6 items-center">
          <div class="relative size-[150px] shrink-0">
            <div class="absolute inset-0 rounded-full" style="background: <%= @summary.donut_gradient %>"></div>
            <div class="absolute inset-[22px] rounded-full bg-white flex flex-col items-center justify-center">
              <span class="text-[11px] text-gray-500">Total</span>
              <span class="text-base font-bold text-green-black"><%= money_amount(@summary.donut_total) %></span>
            </div>
          </div>
          <div class="flex flex-col gap-2 flex-1 min-w-0">
            <% @summary.donut_slices.each do |slice| %>
              <div class="flex items-center gap-2 text-[13px]">
                <span class="size-[9px] rounded-full shrink-0" style="background-color: <%= slice.hex %>"></span>
                <span class="text-gray-800 flex-1 truncate"><%= slice.name %></span>
                <span class="text-gray-500 tabular-nums"><%= slice.percent %>%</span>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="<%= panel_classes("flex-[1.3] p-6") %>">
      <div class="flex justify-between items-center mb-3.5">
        <div class="<%= section_heading_classes %>">Recent transactions</div>
        <%= link_to "View all →", transactions_path, class: "text-[13px] font-semibold text-invoca-green hover:text-green-600 hover:underline" %>
      </div>

      <% if @summary.recent_transactions.empty? %>
        <p class="text-sm text-gray-500">Nothing recorded yet.</p>
      <% else %>
        <div class="flex flex-col">
          <% @summary.recent_transactions.each do |transaction| %>
            <div class="flex items-center gap-3 py-2.5 border-b border-gray-200 last:border-b-0">
              <%= category_dot transaction.category, size: "size-2" %>
              <div class="flex-1 min-w-0">
                <div class="text-[13px] font-medium text-green-black truncate"><%= transaction.description.presence || transaction.txn_type.titleize %></div>
                <div class="text-xs text-gray-500 truncate"><%= transaction.occurred_on.strftime("%b %-d") %> · <%= transaction.account.name %></div>
              </div>
              <div class="text-sm font-semibold whitespace-nowrap <%= transaction_amount_class(transaction) %>"><%= signed_money_amount(transaction.amount) %></div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
