<% content_for :title, "Budgets · Moneymap" %>
<% overview = @overview %>
<% bar_colors = { over: "bg-problem-red", watch: "bg-gray-700", on_track: "bg-invoca-green" } %>

<%= render layout: "shared/page_header",
      locals: { title: "Budgets", subtitle: overview.month.strftime("%B %Y") } do %>
  <div class="flex items-center gap-3">
    <%# Budgets track the month you're spending in, so this page defaults to the
        current month rather than the last complete one — hence the stepper. %>
    <div class="flex items-center bg-white border border-gray-200 rounded-xl p-[3px]">
      <%= link_to budgets_path(month: overview.month.prev_month), class: "p-1.5 rounded-lg text-gray-500 hover:text-green-black hover:bg-gray-50", aria: { label: "Previous month" } do %>
        <%= icon "chevron-left", class: "size-4" %>
      <% end %>
      <%= link_to budgets_path, class: "px-2.5 text-[13px] font-semibold text-gray-500 hover:text-green-black", title: "Jump to this month" do %>
        Today
      <% end %>
      <%= link_to budgets_path(month: overview.month.next_month), class: "p-1.5 rounded-lg text-gray-500 hover:text-green-black hover:bg-gray-50", aria: { label: "Next month" } do %>
        <%= icon "chevron-right", class: "size-4" %>
      <% end %>
    </div>

    <%= link_to new_budget_path(month: overview.month), class: primary_button_classes do %>
      <%= icon "circle-plus", class: "size-4" %>
      New budget
    <% end %>
  </div>
<% end %>

<% if overview.lines.empty? %>
  <%= render "shared/empty_state",
        icon: "wallet",
        title: "No budgets for #{overview.month.strftime('%B %Y')}",
        body: "Set a monthly target on an expense category and Moneymap will track your spending against it here.",
        action_label: "Create a budget",
        action_path: new_budget_path(month: overview.month) %>
<% else %>
  <div class="<%= panel_classes("p-6 flex justify-between items-center gap-8") %>">
    <div class="flex-1">
      <div class="flex justify-between text-[13px] text-gray-500 mb-2">
        <span>
          <span class="font-bold text-green-black"><%= money_amount(overview.summary.spent) %></span>
          spent of <%= money_amount(overview.summary.target) %> budgeted
        </span>
        <span><%= overview.summary.percent %>%</span>
      </div>
      <div class="h-2.5 rounded-full bg-gray-100 overflow-hidden">
        <div class="h-full rounded-full <%= overview.summary.percent > 100 ? "bg-problem-red" : "bg-invoca-green" %>"
             style="width: <%= overview.summary.bar_width %>%"></div>
      </div>
    </div>
    <div class="text-right shrink-0">
      <div class="<%= eyebrow_classes %>">Remaining</div>
      <div class="text-[22px] font-black text-green-black"><%= money_amount(overview.summary.remaining) %></div>
    </div>
  </div>

  <div class="grid grid-cols-[repeat(auto-fill,minmax(260px,1fr))] gap-[18px]">
    <% overview.lines.each do |line| %>
      <div class="<%= panel_classes("p-5") %>">
        <div class="flex justify-between items-center gap-2 mb-3">
          <span class="flex items-center gap-2 text-sm font-semibold text-green-black min-w-0">
            <%= category_dot line.category, size: "size-[9px]" %>
            <span class="truncate"><%= line.category.name %></span>
          </span>
          <%= render "budgets/status_pill", status: line.status %>
        </div>

        <div class="h-2 rounded-full bg-gray-100 overflow-hidden mb-2.5">
          <div class="h-full rounded-full <%= bar_colors.fetch(line.status) %>" style="width: <%= line.bar_width %>%"></div>
        </div>

        <div class="flex justify-between text-[13px]">
          <span class="text-green-black font-semibold"><%= money_amount(line.spent) %></span>
          <span class="text-gray-500">of <%= money_amount(line.target) %></span>
        </div>
        <div class="mt-1 flex justify-between items-center gap-2">
          <span class="text-xs text-gray-500"><%= line.remaining_text %></span>
          <span class="flex gap-1">
            <%= link_to edit_budget_path(line.budget), class: "p-1 rounded-md text-gray-400 hover:text-green-black hover:bg-gray-100", title: "Edit", aria: { label: "Edit budget" } do %>
              <%= icon "pencil", class: "size-3.5" %>
            <% end %>
            <%= button_to budget_path(line.budget), method: :delete,
                  data: { turbo_confirm: "Delete the #{line.category.name} budget?" },
                  class: "p-1 rounded-md text-gray-400 hover:text-problem-red hover:bg-problem-salmon cursor-pointer", title: "Delete", aria: { label: "Delete budget" } do %>
              <%= icon "trash-2", class: "size-3.5" %>
            <% end %>
          </span>
        </div>
      </div>
    <% end %>
  </div>

  <% if overview.unbudgeted.positive? %>
    <p class="text-[13px] text-gray-500">
      <%= money_amount(overview.unbudgeted) %> of <%= overview.month.strftime("%B") %> spending sits in categories with no budget.
      <%= link_to "Add a budget", new_budget_path(month: overview.month), class: "font-semibold text-invoca-green hover:underline" %>
      to bring it into this total.
    </p>
  <% end %>
<% end %>
