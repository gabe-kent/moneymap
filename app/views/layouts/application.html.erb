<!DOCTYPE html>
<html data-theme="invoca">
  <head>
    <title><%= content_for(:title) || "Moneymap" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Moneymap">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Inter is the Invoca brand's chosen web face (it stands in for GT America).
        Loaded from Google Fonts; the stack in the Tailwind theme falls back to
        the system sans if it can't be fetched. %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="font-sans text-gray-800 antialiased">
    <% if authenticated? %>
      <div class="flex min-h-screen bg-sand">
        <%= render "shared/sidebar" %>

        <main class="flex-1 min-w-0 pt-8 px-10 pb-14 flex flex-col gap-7">
          <%= render "shared/flashes" %>
          <%= yield %>
        </main>
      </div>
    <% else %>
      <div class="min-h-screen bg-sand flex flex-col items-center justify-center gap-6 py-16 px-5">
        <%= render "shared/brand", size: :large %>

        <div class="w-full max-w-md flex flex-col gap-4">
          <%= render "shared/flashes" %>
          <%= yield %>
        </div>
      </div>
    <% end %>
  </body>
</html>
