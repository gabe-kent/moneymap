<% content_for :title, "Feature flags · Moneymap" %>

<%= render layout: "shared/page_header",
      locals: { title: "Feature flags", subtitle: "Global enablement always wins over a per-user override." } do %><% end %>

<div class="<%= panel_classes("overflow-hidden") %>">
  <div class="grid grid-cols-[200px_110px_1fr_280px] py-2.5 px-6 border-b border-gray-200 <%= eyebrow_classes %>">
    <span>Key</span><span>Global</span><span>Per-user overrides</span><span>Grant to</span>
  </div>

  <% @feature_flags.each do |flag| %>
    <div class="grid grid-cols-[200px_110px_1fr_280px] py-4 px-6 items-start gap-4 border-b border-gray-200 last:border-b-0">
      <span class="text-sm font-semibold text-green-black font-mono pt-1.5"><%= flag.key %></span>

      <span class="pt-0.5">
        <%# The whole pill is the toggle — one PATCH, no confirm, since flipping
            back is just as cheap. %>
        <%= button_to admin_feature_flag_path(flag), method: :patch,
              class: class_names("inline-flex items-center gap-1.5 py-1.5 px-3 rounded-full text-[13px] font-semibold cursor-pointer transition-colors",
                                 flag.globally_enabled? ? "bg-mint text-invoca-green hover:bg-green-100" : "bg-gray-100 text-gray-700 hover:bg-gray-200"),
              title: flag.globally_enabled? ? "Disable globally" : "Enable globally" do %>
          <%= icon flag.globally_enabled? ? "toggle-right" : "toggle-left", class: "size-4" %>
          <%= flag.globally_enabled? ? "On" : "Off" %>
        <% end %>
      </span>

      <span class="pt-1">
        <% if flag.feature_flag_assignments.empty? %>
          <span class="text-[13px] text-gray-500">None</span>
        <% else %>
          <ul class="flex flex-col gap-1.5">
            <% flag.feature_flag_assignments.each do |assignment| %>
              <li class="flex items-center gap-2 group">
                <span class="text-[13px] text-gray-800 truncate"><%= assignment.user.email_address %></span>
                <%= button_to admin_feature_flag_assignment_path(flag, assignment), method: :delete,
                      class: "p-1 rounded-md text-gray-400 hover:text-problem-red hover:bg-problem-salmon cursor-pointer opacity-0 group-hover:opacity-100 focus-within:opacity-100 transition-opacity",
                      title: "Revoke", aria: { label: "Revoke access for #{assignment.user.email_address}" } do %>
                  <%= icon "x", class: "size-3.5" %>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% end %>
      </span>

      <%= form_with url: admin_feature_flag_assignments_path(flag), class: "flex gap-2" do |form| %>
        <%= form.email_field :email_address, placeholder: "user@example.com", required: true,
              class: "flex-1 min-w-0 py-2 px-3 bg-white border border-gray-200 rounded-xl text-[13px] outline-none focus:border-invoca-green" %>
        <%= form.submit "Grant", class: "py-2 px-3.5 rounded-xl bg-invoca-green text-white text-[13px] font-semibold cursor-pointer transition-colors hover:bg-green-600 shrink-0" %>
      <% end %>
    </div>
  <% end %>
</div>
